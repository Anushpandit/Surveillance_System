# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.

# --- Authentication ---
# Replace the development secret before deployment.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Telegram Bot ---
# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get this by messaging your bot, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Database ---
DATABASE_URL=sqlite:///./surveillance.db

# --- Detection settings ---
CONFIDENCE_THRESHOLD=0.6
# The custom weapon model works best with a lower confidence cutoff.
WEAPON_CONFIDENCE_THRESHOLD=0.0015
ACCIDENT_CONFIDENCE_THRESHOLD=0.5
# Optional override for the weapon YOLO weights.
# WEAPON_MODEL_PATH=data/Weapon_detect/best.pt
FRAME_SKIP=5
ALERT_COOLDOWN_SECONDS=45

# --- App settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
